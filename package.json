{
  "name": "agents-chat-room",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "ao": "bin/ao.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "install:cli": "node scripts/install-cli.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:acceptance": "node --test --test-concurrency=1 test/acceptance.test.js",
    "test:issue-realtime": "node scripts/verify-issue-independence.mjs",
    "check": "node --check src/server.js && node --check bin/ao.js && npm test"
  }
}
